# Billing / daily AI spend: first server start seeds BillingSettings from these env values;
# after that, Admins edit under UI → Billing (/admin/billing).
# BILLING_ENABLED=true
# BILLING_DAILY_CAP_USD=1.5
# BILLING_PRO_MIN_REMAINING_USD=0.5
# BILLING_POWER_ROLES=ADMIN,PROJECT_MANAGER
# BILLING_WARN_INPUT_TOKENS=50000
# BILLING_MAX_PROMPT_CHARS=2000000
