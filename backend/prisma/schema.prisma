generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String                   @id @default(uuid())
  email        String                   @unique
  passwordHash String
  name         String
  role         UserRole
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  projectRoles ProjectMember[]
  tmEntries    TranslationMemoryEntry[]
  tmFiles      TranslationMemoryFile[]
}

model Project {
  id            String                   @id @default(uuid())
  name          String
  description   String?
  clientName    String?
  domain        String?
  sourceLocale  String
  sourceLang    String?
  targetLocales String[]
  targetLang    String?
  status        ProjectStatus            @default(PLANNING)
  dueDate       DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  chatMessages  ChatMessage[]
  documents     Document[]
  glossary      GlossaryEntry[]
  aiSettings    ProjectAISetting?
  guidelines    ProjectGuideline?
  members       ProjectMember[]
  reports       Report[]
  tmEntries     TranslationMemoryEntry[]
  tmFiles       TranslationMemoryFile[]
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      UserRole
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
}

model Profile {
  id             String    @id @default(uuid())
  name           String
  expertRole     String
  instructions   String    @db.Text
  terminologyJSON Json?
  documents      Document[]
}

model Document {
  id                 String                  @id @default(uuid())
  name               String
  filename           String?
  projectId          String
  profileId          String?
  status             DocumentStatus          @default(NEW)
  fileType           DocumentFileType?
  sourceLocale       String
  targetLocale       String
  storagePath        String
  wordCount          Int                     @default(0)
  totalSegments      Int                     @default(0)
  totalWords         Int                     @default(0)
  version            Int                     @default(1)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  summary            String?                 @db.Text
  summaryGeneratedAt DateTime?
  clusterId          String?
  clusterSummary     String?
  documentEmbedding  Unsupported("vector")?
  embeddingModel     String?
  embeddingUpdatedAt DateTime?
  aiRequests         AIRequest[]
  chatMessages       ChatMessage[]
  project            Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profile            Profile?                 @relation(fields: [profileId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  analysis           DocumentAnalysis?
  documentDna        DocumentDna?
  glossaryEntries    DocumentGlossaryEntry[]
  styleRules         DocumentStyleRule[]
  segments           Segment[]

  @@index([clusterId])
  @@index([documentEmbedding])
  @@index([profileId])
}

model Segment {
  id                 String                 @id @default(uuid())
  documentId         String
  segmentIndex       Int
  sourceText         String
  targetMt           String?
  targetFinal        String?
  status             SegmentStatus          @default(NEW)
  fuzzyScore         Int?
  bestTmEntryId      String?
  confirmedById      String?
  confirmedAt        DateTime?
  timeSpentSeconds   Int?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  embeddingModel     String?
  embeddingUpdatedAt DateTime?
  sourceEmbedding    Unsupported("vector")?
  segmentType        String?                @default("paragraph")
  mtFullPrompt       String?                @db.Text
  mtAnalysis         String?
  chatMessages       ChatMessage[]
  qualityMetric      QualityMetric?
  document           Document               @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([documentId, segmentIndex], name: "documentId_segmentIndex")
}

model TranslationMemoryFile {
  id             String                   @id @default(uuid())
  name           String
  filename       String
  storagePath    String?
  externalUrl    String?
  projectId      String?
  clientName     String?
  domain         String?
  entryCount     Int                      @default(0)
  createdById    String
  lastImportedAt DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  entries        TranslationMemoryEntry[]
  createdBy      User                     @relation(fields: [createdById], references: [id])
  project        Project?                 @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model TranslationMemoryEntry {
  id                 String                 @id @default(uuid())
  projectId          String?
  createdById        String
  sourceLocale       String
  targetLocale       String
  sourceText         String
  targetText         String
  matchRate          Float?
  usageCount         Int                    @default(0)
  createdAt          DateTime               @default(now())
  clientName         String?
  domain             String?
  tmxFileId          String?
  embeddingModel     String?
  embeddingUpdatedAt DateTime?
  embeddingVersion   String?
  sourceEmbedding    Unsupported("vector")?
  entryType          String?
  createdBy          User                   @relation(fields: [createdById], references: [id])
  project            Project?               @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tmxFile            TranslationMemoryFile? @relation(fields: [tmxFileId], references: [id])

  @@index([projectId, sourceLocale, targetLocale])
  @@index([sourceLocale, targetLocale, usageCount])
  @@index([projectId, usageCount])
}

model GlossaryEntry {
  id                 String                 @id @default(cuid())
  projectId          String?
  sourceTerm         String
  targetTerm         String
  sourceLocale       String
  targetLocale       String
  notes              String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  client             String?
  direction          String
  domain             String?
  isForbidden        Boolean                @default(false)
  contextRules       Json?
  sourceEmbedding    Unsupported("vector")?
  embeddingModel     String?
  embeddingUpdatedAt DateTime?
  status             GlossaryStatus         @default(PREFERRED)
  project            Project?               @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([sourceEmbedding])
}

model AIRequest {
  id          String          @id @default(uuid())
  documentId  String
  type        AIRequestType
  status      AIRequestStatus @default(QUEUED)
  payload     Json
  result      Json?
  createdAt   DateTime        @default(now())
  completedAt DateTime?
  document    Document        @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Report {
  id        String     @id @default(uuid())
  projectId String
  type      ReportType
  payload   Json
  createdAt DateTime   @default(now())
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model QualityMetric {
  id                String   @id @default(uuid())
  segmentId         String   @unique
  mtWordCount       Int      @default(0)
  finalWordCount    Int      @default(0)
  editDistanceChars Int      @default(0)
  termErrors        Int      @default(0)
  formatErrors      Int      @default(0)
  consistencyErrors Int      @default(0)
  timeSpentSeconds  Int      @default(0)
  createdAt         DateTime @default(now())
  segment           Segment  @relation(fields: [segmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model ProjectAISetting {
  id          String   @id @default(uuid())
  projectId   String   @unique
  provider    String
  model       String
  temperature Float?
  maxTokens   Int?
  config      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectGuideline {
  id        String   @id @default(uuid())
  projectId String   @unique
  rules     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id         String    @id @default(uuid())
  projectId  String
  documentId String?
  segmentId  String?
  role       String
  content    String
  metadata   Json?
  createdAt  DateTime  @default(now())
  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  segment    Segment?  @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([documentId])
  @@index([segmentId])
  @@index([createdAt])
}

model DocumentAnalysis {
  id                  String    @id @default(uuid())
  documentId          String    @unique
  status              String    @default("PENDING")
  glossaryExtracted   Boolean   @default(false)
  styleRulesExtracted Boolean   @default(false)
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  currentStage        String?
  progressPercentage  Int       @default(0)
  currentMessage      String?
  detectedDomain      String?
  detectedTone        String?
  translationStrategy String?
  executionLogs       Json?
  document            Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model DocumentGlossaryEntry {
  id              String   @id @default(uuid())
  documentId      String
  sourceTerm      String
  targetTerm      String
  createdAt       DateTime @default(now())
  occurrenceCount Int      @default(1)
  status          String?
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([status])
}

model DocumentStyleRule {
  id          String   @id @default(uuid())
  documentId  String
  ruleType    String
  pattern     String
  description String?
  examples    Json?
  priority    Int      @default(50)
  createdAt   DateTime @default(now())
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model DocumentDna {
  id                  String   @id @default(uuid())
  documentId          String   @unique
  technicalSchema    Json?    // domain/object types, structure
  namingConventions  Json?    // phase names, type labels, notation rules
  abbreviationLogic  Json?    // project-specific abbreviations and expansions
  entityGroups       Json?    // term variations, synonyms, grouped entities
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  document           Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

enum UserRole {
  ADMIN
  PROJECT_MANAGER
  LINGUIST
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
}

enum DocumentStatus {
  NEW
  IN_PROGRESS
  COMPLETED
}

enum SegmentStatus {
  NEW
  MT
  EDITED
  CONFIRMED
}

enum GlossaryStatus {
  PREFERRED
  DEPRECATED
  CANDIDATE
}

enum ReportType {
  PROGRESS
  QUALITY
}

enum AIRequestType {
  TRANSLATION
  QA
  SUMMARY
}

enum AIRequestStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum DocumentFileType {
  DOCX
  XLIFF
  XLSX
}
